{
  "name": "dotnet-ecommerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nx run-many -t serve -p api web --parallel=2",
    "dev:api": "nx serve api",
    "dev:web": "nx serve web",
    "build": "nx run-many -t build -p api web",
    "graph": "nx graph",
    "test:smoke": "node --test tests/api.smoke.test.mjs",
    "docker:up": "docker compose up --build --detach --wait",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "nx": "23.2.1",
    "@nx/angular": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@nx/dotnet": "23.2.1",
    "@angular/build": "21.2.24",
    "@angular/compiler-cli": "21.2.25",
    "typescript": "5.9.3"
  },
  "overrides": {
    "piscina": "5.3.2",
    "axios": "1.20.0",
    "smol-toml": "1.9.0",
    "brace-expansion@>=4.0.0": "5.0.12"
  }
}
